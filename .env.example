# 这些 AI_* 变量只由服务端读取。不要使用 VITE_ 前缀保存密钥。
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-flash
AI_API_KEY=
# DeepSeek 短教学使用非思考模式；其他兼容服务不支持此扩展时留空。
AI_THINKING=disabled
COACH_HOST=127.0.0.1
COACH_PORT=8787
COACH_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173,capacitor://localhost,https://localhost,tauri://localhost,http://tauri.localhost
# 原生包需要填写已部署的 HTTPS 师父接口；Web 默认使用同源 /api/coach。
VITE_COACH_URL=
